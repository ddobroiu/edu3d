# --- Baza de date -----------------------------------------------------------
# Aceeasi instanta ca la kidmy si 3dview. edu3d foloseste doar tabelele edu3d_*.
DATABASE_URL="postgresql://user:parola@host:5432/toateproiectele"

# --- Autentificare ----------------------------------------------------------
# Genereaza cu: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_SECRET=""
# Local: http://localhost:3000 | Server: http://178.104.20.127:3004
NEXTAUTH_URL="http://178.104.20.127:3004"
AUTH_TRUST_HOST="true"

# Optional: login cu Google. Daca lipsesc, butonul nu apare.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Adrese publice ---------------------------------------------------------
# Din ele se construiesc linkurile catre /api/storage si adresele de retur Stripe.
# Cand pui domeniul, schimba-le aici si vezi nota din README despre modelele deja generate.
NEXT_PUBLIC_BASE_URL="http://178.104.20.127:3004"
NEXT_PUBLIC_APP_URL="http://178.104.20.127:3004"

# --- Generare 3D (Replicate) ------------------------------------------------
REPLICATE_API_TOKEN=""

# --- Storage (Cloudflare R2) ------------------------------------------------
# Foloseste un bucket separat de kidmy / 3dview.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="edu3d-assets"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"

# --- Plati (Stripe) ---------------------------------------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Din dashboard-ul Stripe, pentru endpoint-ul https://edu3d.ro/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="edu3d <contact@edu3d.ro>"

# --- Biblioteca de modele (Sketchfab) ------------------------------------
SKETCHFAB_API_KEY=""

# Protejeaza /api/cron/* (curatarea bibliotecii)
CRON_SECRET=""

# --- Facturare (Oblio) ------------------------------------------------------
OBLIO_CLIENT_ID=""
OBLIO_CLIENT_SECRET=""
OBLIO_CIF_FIRMA=""
OBLIO_SERIE_FACTURA=""
